# LandIt AI — environment template
# Do not put real secrets in git. XAI_API_KEY is injected by the platform in preview/deploy.

# Payment mode ladder: demo | test | live
# live only after Commercial Preflight in SHIP_LOG.md is approved
VITE_PAYMENTS_MODE=demo

# Stripe Payment Links (required when VITE_PAYMENTS_MODE=test or live)
VITE_STRIPE_PAYMENT_LINK_PRO=
VITE_STRIPE_PAYMENT_LINK_LIFETIME=

# Optional success redirect targets from Stripe (configure in Stripe Dashboard)
# Success URL example: https://YOUR_DOMAIN/success?plan=pro&mode=live

# Server-only (platform injects in this environment — do not invent .env for XAI in preview)
# XAI_API_KEY=
